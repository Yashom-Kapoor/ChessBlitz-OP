# Copy to .env and fill in. Ask in the club chat for values.
# NEVER commit the real .env — it is gitignored, keep it that way.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Note: OPEN_ROUTER_KEY, not OPENROUTER_API_KEY
OPEN_ROUTER_KEY=your_openrouter_key

# Optional, defaults to 5000.
# On macOS, AirPlay Receiver squats on 5000 — change this or disable AirPlay.
PORT=5000

# Dev tools: set to 1 to enable the /dev/* endpoints the app's dev menu uses
# (set currency, unlock all board themes, create a missing Shop row).
# Leave it at 0 in production — those routes 404 when it is off.
DEV_TOOLS=0
